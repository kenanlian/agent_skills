node_modules/
dist/
renders/
.hyperframes/

# theme*/ is committed so every clone renders the same look. Each obsidian.css
# carries Obsidian's proprietary app.css: keep this repository private, or
# ignore theme*/ as well. Fonts are never committed; `npm run fetch:fonts`
# installs the versions style.json pins.
theme*/fonts/
covers/assets/fonts/
.fonts-cache/

# Licensed music; the license may not allow redistribution. Voice takes in
# audio/voice/ (raw/ especially) stay committed: they are billed per character.
audio/bgm/
audio/source/

# Build outputs copied into each HyperFrames project.
episodes/*/assets/

# Recorded mode: raw takes are large; work/ is regenerated. The caption font's
# license forbids redistributing it on its own; fetch:fonts downloads it.
records/
recorded/*/work/
/fonts/
