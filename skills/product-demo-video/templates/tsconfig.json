{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["svelte", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "obsidian": ["../obsidian-card-workspace/node_modules/obsidian"],
      "@plugin/*": ["../obsidian-card-workspace/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
